    "# example input\n",
    "prompt = \"generate a short, fairy tale genre, nighttime story. the response should contain only the story.\"\n",
    "\n",
    "inp = tokenizer(prompt, return_tensors=\"pt\")['input_ids'].to(model.device)\n",
    "output = model.generate(inp,\n",
