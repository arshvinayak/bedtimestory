    "\n",
    "\n",
    "input_sentences = tokenizer.decode(output[0],\n",
    "                                   skip_special_tokens=True,\n",
    "                                   clean_up_tokenization_spaces=True).strip(prompt+\"\\n\\n\")"
   ]
